@model MonkeyArchive.Models.AdminTowerForm
@{
    ViewData["Title"] = "New tower";
    ViewData["Subtitle"] = "Inserts a row into the Tower table";
}

<section class="admin-panel admin-panel-form">
    @* Keine versteckte ID wie beim Bearbeiten: die vergibt beim INSERT das
       AUTO_INCREMENT der Tabelle. *@
    <form method="post" asp-controller="Admin" asp-action="CreateTower">
        <div class="admin-form-grid">
            <div class="admin-field">
                <label for="Name">Name</label>
                <input type="text" id="Name" name="Name" value="@Model.Name" required autocomplete="off">
            </div>

            <div class="admin-field">
                <label for="Slug">Slug</label>
                <input type="text" id="Slug" name="Slug" value="@Model.Slug" required autocomplete="off">
                <span class="admin-field-hint">Used in the URL, for example /Towers/Details/dart-monkey</span>
            </div>

            <div class="admin-field">
                <label for="CategoryId">Category</label>
                <select id="CategoryId" name="CategoryId">
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
                    }
                </select>
            </div>

            <div class="admin-field">
                <label for="ImageFileName">Image file name</label>
                <input type="text" id="ImageFileName" name="ImageFileName" value="@Model.ImageFileName" autocomplete="off">
                <span class="admin-field-hint">File inside wwwroot/images/monkeys/</span>
            </div>
        </div>

        <div class="admin-field">
            <label for="Description">Description</label>
            <textarea id="Description" name="Description" rows="4">@Model.Description</textarea>
        </div>

        <div class="admin-form-grid admin-form-grid-4">
            <div class="admin-field">
                <label for="Cost">Cost</label>
                <input type="number" id="Cost" name="Cost" value="@Model.Cost" required>
            </div>

            <div class="admin-field">
                <label for="Damage">Damage</label>
                <input type="number" id="Damage" name="Damage" value="@Model.Damage" required>
            </div>

            <div class="admin-field">
                <label for="Pierce">Pierce</label>
                <input type="number" id="Pierce" name="Pierce" value="@Model.Pierce" required>
            </div>

            <div class="admin-field">
                <label for="Range">Range</label>
                <input type="number" id="Range" name="Range" value="@(Model.Range?.ToString() ?? "")">
                <span class="admin-field-hint">Empty = infinite range (Sniper, Dartling).</span>
            </div>
        </div>

        <div class="admin-form-grid">
            <div class="admin-field">
                <label for="GameVersion">Game version</label>
                <input type="text" id="GameVersion" name="GameVersion" value="@Model.GameVersion" autocomplete="off">
            </div>
        </div>

        @* Upgrade Pfade gehören in eine eigene Tabelle und sind hier nicht dabei.
           Der neue Tower hat darum erst einmal keine. *@
        <p class="admin-panel-hint">
            Upgrade paths live in the TowerUpgradePaths table and are not part of this form.
            A new tower starts without any.
        </p>

        <div class="admin-form-actions">
            <button type="submit" class="admin-btn admin-btn-primary">Create tower</button>
            <a class="admin-btn admin-btn-ghost" asp-action="Towers">Cancel</a>
        </div>
    </form>
</section>
