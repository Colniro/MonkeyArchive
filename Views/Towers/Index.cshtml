@model MonkeyArchive.Models.TowersOverviewViewModel
@{
    ViewData["Title"] = "Towers";

    // Die fünf Filter Pills über dem Grid, in dieser Reihenfolge.
    var categories = new[] { "All", "Primary", "Military", "Magic", "Support" };
}

<div class="towers-page">
    <partial name="_Navigation" />

    <main class="towers-main">
        <div class="container">
            <h1 class="page-title">All Towers</h1>

            @* Ein normales GET Formular. Beim Absenden lädt die Seite neu mit dem Suchtext als Query Parameter.
               Gefiltert wird dann in TowersController.Index.
               Die aktuelle Kategorie läuft als verstecktes Feld mit, damit die Suche den Filter nicht zurücksetzt. *@
            <form method="get" asp-action="Index" class="search-bar">
                <button type="submit" class="search-icon" aria-label="Search">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </button>
                <input type="text" data-search-input name="search" value="@Model.Search" placeholder="search Towers" autocomplete="off">
                <button type="button" class="search-clear" data-search-clear aria-label="Clear search">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        <line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </button>
                <input type="hidden" name="category" value="@Model.SelectedCategory">
            </form>

            @* Jede Pille ist ein normaler Link, der den aktuellen Suchtext mitnimmt.
               So bleibt der eingetippte Text stehen, wenn man die Kategorie wechselt. *@
            <div class="filter-pills">
                @foreach (var cat in categories)
                {
                    var activeClass = cat == Model.SelectedCategory ? "active" : "";
                    <a class="filter-pill @activeClass"
                       data-filter="@cat"
                       asp-action="Index"
                       asp-route-category="@cat"
                       asp-route-search="@Model.Search">@cat</a>
                }
            </div>

            <div class="towers-grid">
                @foreach (var tower in Model.Towers)
                {
                    // Bestimmt die Hexagon und Bar Farbe aus der Kategorie, gleich wie bei den Category Cards auf der Startseite.
                    string colorVar = tower.Category switch
                    {
                        "Primary" => "var(--CatBlue)",
                        "Military" => "var(--CatGreen)",
                        "Magic" => "var(--CatPurple)",
                        "Support" => "var(--CatOrange)",
                        _ => "var(--Gray)"
                    };

                    @* .tower-bar muss ein Sibling vor .tower-card bleiben, nicht ein Kind davon.
                       Nur so bleibt die Bar sichtbar, wenn die Karte beim Hover ein transform bekommt.
                       Ein transform öffnet nämlich einen neuen Stacking Context.
                       Eine Bar mit negativem z-index als Kind würde darin einfach verschluckt. *@
                    <div class="tower-item" data-search-item data-name="@tower.Name.ToLowerInvariant()" style="--cat-color: @colorVar">
                        <div class="tower-bar"></div>
                        <a class="tower-card" asp-action="Details" asp-route-id="@tower.Slug">
                            <div class="tower-hexagon">
                                <img src="~/images/monkeys/@tower.Image" alt="@tower.Name">
                            </div>
                            <p>@tower.Name</p>
                        </a>
                    </div>
                }
            </div>

            @* Ist immer im HTML, damit das Live Suche Script es ein und ausblenden kann.
               Der inline style deckt den Fall ohne JavaScript ab, wenn der Kategorie Filter schon zu null Ergebnissen führt. *@
            <p class="no-results" data-no-results style="display:@(Model.Towers.Count == 0 ? "block" : "none")">No towers found.</p>
        </div>
    </main>
</div>

@section Scripts {
    <script src="~/js/list-search.js" asp-append-version="true"></script>
}
