@{
    ViewData["Title"] = "Home";
}

<div class="home-shell">
<div class="page-content">
    <partial name="_Navigation" />
</div>

<section class="hero">
    <img src="~/images/bloons/red_bloon.png" class="bloon bloon-a" alt="">
    <img src="~/images/bloons/red_bloon.png" class="bloon bloon-b" alt="">
    <img src="~/images/assets/camo.png" class="decor-blob" alt="">

    <div class="container hero-container">
        <h1 class="hero-title">BTD6 Towers &amp; Bloons</h1>
        <p class="hero-subtitle">The most important stats clear and organized</p>

        <div class="hero-buttons">
            <a asp-controller="Towers" asp-action="Index" class="btn btn-primary">view Towers</a>
            <a href="bloons.html" class="btn btn-outline">view Bloons</a>
        </div>

        <div class="categories">
            <div class="categories-line">
                <span class="categories-label">Categories</span>
            </div>

            <div class="categories-cards">
                <div class="categories-grid">
                    <div class="category-item" style="--cat-color: var(--CatBlue)">
                        <img src="~/images/monkeys/dart_monkey.png" class="category-mascot" alt="Primary">
                        <div class="category-bar"></div>
                        <a class="category-card" asp-controller="Towers" asp-action="Index" asp-route-category="Primary">
                            <div class="hexagon"></div>
                            <p>Primary</p>
                        </a>
                    </div>
                    <div class="category-item" style="--cat-color: var(--CatGreen)">
                        <img src="~/images/monkeys/sniper_monkey.png" class="category-mascot category-mascot-tall" alt="Military">
                        <div class="category-bar"></div>
                        <a class="category-card" asp-controller="Towers" asp-action="Index" asp-route-category="Military">
                            <div class="hexagon"></div>
                            <p>Military</p>
                        </a>
                    </div>
                    <div class="category-item" style="--cat-color: var(--CatPurple)">
                        <img src="~/images/monkeys/druid_monkey.png" class="category-mascot" alt="Magic">
                        <div class="category-bar"></div>
                        <a class="category-card" asp-controller="Towers" asp-action="Index" asp-route-category="Magic">
                            <div class="hexagon"></div>
                            <p>Magic</p>
                        </a>
                    </div>
                    <div class="category-item" style="--cat-color: var(--CatOrange)">
                        <img src="~/images/monkeys/engineer_monkey.png" class="category-mascot category-mascot-tall" alt="Support">
                        <div class="category-bar"></div>
                        <a class="category-card" asp-controller="Towers" asp-action="Index" asp-route-category="Support">
                            <div class="hexagon"></div>
                            <p>Support</p>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
</div>
