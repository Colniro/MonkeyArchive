@{
    ViewData["Title"] = "Page not found";

    // Deko für grosse Bildschirme (Regeln in site.css unter .side-decor).
    // Side ist "left" oder "right", Edge der Abstand zu diesem Rand. Negative
    // Werte lassen den Ballon über die Kante hinausragen. Top ist Prozent der
    // Fensterhöhe, weil die Ebene position: fixed ist.
    // Duration und Delay sind pro Ballon anders, sonst wippen alle im Gleichschritt.
    (string Image, string Side, int Edge, int Top, int Width, string Duration, string Delay)[] decorBloons =
    [
        ("green_bloon.png", "left", 150, 8, 72, "4.6s", "0s"),
        ("blue_bloon.png", "left", 46, 28, 58, "5.4s", "1.3s"),
        ("pink_bloon.png", "left", 210, 48, 88, "4.2s", "2.5s"),
        ("yellow_bloon.png", "left", 80, 70, 64, "5.8s", "0.7s"),
        ("red_bloon.png", "right", 130, 12, 80, "5.0s", "1.8s"),
        ("purple_bloon.png", "right", 48, 36, 60, "4.4s", "0.4s"),
        ("green_bloon.png", "right", 200, 56, 70, "5.6s", "2.2s"),
        ("blue_bloon.png", "right", 94, 78, 86, "4.8s", "1.1s")
    ];
}

<div class="towers-page notfound-page">
    @* Gleiche Deko Ebene wie auf den Übersichts- und Account Seiten, hier aber
       fest verdrahtet: die 404 Seite hat kein Model, aus dem sich Bilder
       holen liessen. Liegt vor dem main im Markup, damit der Inhalt obenauf
       bleibt (siehe .side-decor ~ .towers-main in site.css). *@
    <div class="side-decor" aria-hidden="true">
        @foreach (var decorBloon in decorBloons)
        {
            <div class="bloon-float side-item"
                 style="@(decorBloon.Side): @(decorBloon.Edge)px; top: @(decorBloon.Top)%; animation-duration: @decorBloon.Duration; animation-delay: @decorBloon.Delay;">
                <img src="~/images/bloons/@decorBloon.Image" alt="" loading="lazy"
                     style="width: @(decorBloon.Width)px;">
            </div>
        }

        <img class="side-monkey side-monkey-left" src="~/images/monkeys/mortar_monkey.png" alt="" loading="lazy">
        <img class="side-monkey side-monkey-right" src="~/images/monkeys/monkey_ace_monkey.png" alt="" loading="lazy">
    </div>

    <partial name="_Navigation" />

    <main class="towers-main">
        <div class="container notfound-inner">
            <p class="notfound-code">404</p>
            <h1 class="notfound-title">This page popped</h1>
            <p class="notfound-text">
                Whatever you were looking for is not on the track any more.
                Maybe it was never here, maybe a Super Monkey got to it first.
            </p>

            <a asp-controller="Home" asp-action="Index" class="btn btn-primary notfound-back">Back to the Archive</a>

            @* Easter Egg: ein kaum sichtbarer Hinweis auf die geheime /elprimo Seite.
               Base64 dekodiert ergibt den Pfad. Die Farbe liegt fast auf der
               Hintergrundfarbe, lesbar wird die Zeile erst beim Markieren oder
               wenn man mit der Maus draufgeht (siehe .notfound-hint in site.css). *@
            <p class="notfound-hint">L2VscHJpbW8=</p>
        </div>
    </main>
</div>
