<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MonkeyArchive</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MonkeyArchive.styles.css" asp-append-version="true" />
</head>
<body>

    <main role="main">
        @RenderBody()
    </main>

    @* No jQuery/Bootstrap JS bundle: category filtering is plain server-side
       Razor via query-string GET links. Individual pages can still opt into
       a small script of their own (e.g. live search) through this section. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
