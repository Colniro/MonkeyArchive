@{
    // Hintergrund Deko für die vier Account Seiten (Login, Register, ForgotPassword,
    // ResetPassword). Regeln dazu in site.css unter .side-decor.
    // Die Karte steht mitten auf einer dunkelgrünen Fläche, links und rechts davon
    // ist auf grossen Bildschirmen viel leer. Hier kommen Ballons hin und unten in
    // die Ecken zwei Affen.
    //
    // Side ist "left" oder "right", Edge der Abstand zu diesem Rand in Pixel.
    // Top ist Prozent der Fensterhöhe, damit es auf jeder Höhe passt.
    // Duration und Delay sind pro Ballon anders, sonst wippen alle im Gleichschritt.
    (string Image, string Side, int Edge, int Top, int Width, string Duration, string Delay)[] authBloons =
    [
        ("red_bloon.png", "left", 120, 10, 78, "4.6s", "0s"),
        ("blue_bloon.png", "left", 40, 34, 60, "5.4s", "1.2s"),
        ("green_bloon.png", "left", 200, 52, 92, "4.2s", "2.4s"),
        ("yellow_bloon.png", "left", 90, 74, 66, "5.8s", "0.6s"),
        ("pink_bloon.png", "right", 140, 14, 84, "5.0s", "1.7s"),
        ("purple_bloon.png", "right", 50, 40, 62, "4.4s", "0.3s"),
        ("blue_bloon.png", "right", 190, 58, 74, "5.6s", "2.1s"),
        ("green_bloon.png", "right", 100, 80, 90, "4.8s", "1.0s")
    ];
}

<div class="side-decor side-decor-auth" aria-hidden="true">
    @foreach (var authBloon in authBloons)
    {
        <div class="bloon-float side-item"
             style="@(authBloon.Side): @(authBloon.Edge)px; top: @(authBloon.Top)%; animation-duration: @authBloon.Duration; animation-delay: @authBloon.Delay;">
            <img src="~/images/bloons/@authBloon.Image" alt="" loading="lazy"
                 style="width: @(authBloon.Width)px;">
        </div>
    }

    @* Zwei Affen, die von unten in die Ecken schauen. *@
    <img class="side-monkey side-monkey-left" src="~/images/monkeys/alchemist_monkey.png" alt="" loading="lazy">
    <img class="side-monkey side-monkey-right" src="~/images/monkeys/super_monkey_monkey.png" alt="" loading="lazy">
</div>
