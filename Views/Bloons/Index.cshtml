@model MonkeyArchive.Models.BloonsOverviewViewModel
@{
    ViewData["Title"] = "Bloons";

    // Die zwei Filter Pills über dem Grid, in dieser Reihenfolge.
    var categories = new[] { "All", "Normal", "MOAB-Class" };

    // Deko an den Seitenrändern für grosse Bildschirme (Regeln in site.css
    // unter .side-decor). Side ist "left" oder "right", Edge der Abstand zu
    // diesem Rand. Negative Werte lassen den Ballon über die Kante hinausragen.
    // Top ist Prozent der Fensterhöhe, nicht Pixel: die Ebene ist position: fixed
    // und muss auf jeder Fensterhöhe passen.
    // Duration und Delay sind pro Ballon anders, sonst wippen alle im Gleichschritt.
    (string Side, int Edge, int Top, int Width, string Duration, string Delay)[] decorSlots =
    [
        ("left", -24, 6, 86, "4.6s", "0s"),
        ("left", 48, 22, 58, "5.4s", "1.2s"),
        ("left", 4, 40, 74, "4.2s", "2.4s"),
        ("left", 60, 60, 52, "5.8s", "0.6s"),
        ("left", -18, 78, 80, "5.0s", "1.7s"),
        ("right", -20, 10, 82, "4.4s", "0.3s"),
        ("right", 52, 28, 56, "5.6s", "2.1s"),
        ("right", 8, 48, 76, "4.8s", "1.0s"),
        ("right", 44, 68, 60, "5.2s", "2.7s"),
        ("right", -26, 84, 88, "4.0s", "1.5s")
    ];
}

<div class="towers-page">
    @* Die Ballons kommen aus der gerade gezeigten Liste, gleichmässig verteilt.
       So passt die Deko automatisch zum Filter und zur Suche.
       Die Breite wird mit ImageScale multipliziert, damit jeder Ballon am Schluss
       ungefähr gleich gross aussieht (siehe ImageScale im Bloon Model). *@
    <div class="side-decor" aria-hidden="true">
        @if (Model.Bloons.Count > 0)
        {
            @for (var i = 0; i < decorSlots.Length; i++)
            {
                var slot = decorSlots[i];
                var bloon = Model.Bloons[i * Model.Bloons.Count / decorSlots.Length % Model.Bloons.Count];

                <div class="bloon-float side-item"
                     style="@(slot.Side): @(slot.Edge)px; top: @(slot.Top)%; animation-duration: @slot.Duration; animation-delay: @slot.Delay;">
                    <img src="~/images/bloons/@bloon.Image" alt="" loading="lazy"
                         style="width: @((int)Math.Round(slot.Width * bloon.ImageScale))px;">
                </div>
            }
        }
    </div>

    <partial name="_Navigation" />

    <main class="towers-main">
        <div class="container">
            <h1 class="page-title">All Standard Bloons</h1>

            @* Ein normales GET Formular. Beim Absenden lädt die Seite neu mit dem Suchtext als Query Parameter.
               Gefiltert wird dann in BloonsController.Index.
               Die aktuelle Kategorie läuft als verstecktes Feld mit, damit die Suche den Filter nicht zurücksetzt. *@
            <form method="get" asp-action="Index" class="search-bar">
                <button type="submit" class="search-icon" aria-label="Search">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </button>
                <input type="text" data-search-input name="search" value="@Model.Search" placeholder="search Bloons" autocomplete="off">
                <button type="button" class="search-clear" data-search-clear aria-label="Clear search">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        <line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </button>
                <input type="hidden" name="category" value="@Model.SelectedCategory">
            </form>

            @* Jede Pille ist ein normaler Link, der den aktuellen Suchtext mitnimmt.
               So bleibt der eingetippte Text stehen, wenn man die Kategorie wechselt. *@
            <div class="filter-pills">
                @foreach (var cat in categories)
                {
                    var activeClass = cat == Model.SelectedCategory ? "active" : "";
                    <a class="filter-pill @activeClass"
                       data-filter="@cat"
                       asp-action="Index"
                       asp-route-category="@cat"
                       asp-route-search="@Model.Search">@cat</a>
                }
            </div>

            <div class="towers-grid">
                @* Nutzt die gleichen .tower-* Klassen wie die Towers Seite. So sehen beide Übersichten gleich aus.
                   .tower-bar bleibt ein Sibling vor .tower-card, nicht ein Kind davon.
                   So bleibt sie sichtbar wenn die Karte beim Hover ein transform bekommt.
                   Mehr dazu beim Kommentar zu .tower-bar in site.css. *@
                @foreach (var bloon in Model.Bloons)
                {
                    <div class="tower-item" data-search-item data-name="@bloon.Name.ToLowerInvariant()" style="--cat-color: @bloon.Color">
                        <div class="tower-bar"></div>
                        <a class="tower-card" asp-action="Details" asp-route-id="@bloon.Slug">
                            <div class="tower-hexagon" data-skeleton>
                                <img src="~/images/bloons/@bloon.Image" alt="@bloon.Name"
                                     style="transform: scale(@bloon.ImageScale.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))">
                            </div>
                            <p>@bloon.Name</p>
                        </a>
                    </div>
                }
            </div>

            <p class="no-results" data-no-results style="display:@(Model.Bloons.Count == 0 ? "block" : "none")">No bloons found.</p>
        </div>
    </main>
</div>

@section Scripts {
    <script src="~/js/list-search.js" asp-append-version="true"></script>
    <script src="~/js/skeleton.js" asp-append-version="true"></script>
}
