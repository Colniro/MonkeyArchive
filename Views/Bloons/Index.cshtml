@model MonkeyArchive.Models.BloonsOverviewViewModel
@{
    ViewData["Title"] = "Bloons";

    // The two filter pills shown above the grid, in display order.
    var categories = new[] { "All", "Normal", "MOAB-Class" };
}

<div class="towers-page">
    <partial name="_Navigation" />

    <main class="towers-main">
        <div class="container">
            <h1 class="page-title">All Standard Bloons</h1>

            @* Plain GET form: submitting reloads this page with the search
               term as a query string parameter, filtered server-side in
               BloonsController.Index. The current category is carried along
               as a hidden field so searching doesn't reset the active filter. *@
            <form method="get" asp-action="Index" class="search-bar">
                <button type="submit" class="search-icon" aria-label="Search">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </button>
                <input type="text" data-search-input name="search" value="@Model.Search" placeholder="search Bloons" autocomplete="off">
                <button type="button" class="search-clear" data-search-clear aria-label="Clear search">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        <line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </button>
                <input type="hidden" name="category" value="@Model.SelectedCategory">
            </form>

            @* Each pill is a normal link carrying the current search term
               along, so switching category keeps whatever was typed above. *@
            <div class="filter-pills">
                @foreach (var cat in categories)
                {
                    var activeClass = cat == Model.SelectedCategory ? "active" : "";
                    <a class="filter-pill @activeClass"
                       data-filter="@cat"
                       asp-action="Index"
                       asp-route-category="@cat"
                       asp-route-search="@Model.Search">@cat</a>
                }
            </div>

            <div class="towers-grid">
                @* Reuses the .tower-* card styling from the Towers page - same
                   visual language across both overview pages. .tower-bar stays
                   a sibling *before* .tower-card (not a child) so it keeps
                   rendering behind the card once the card gets a transform on
                   hover; see the comment on .tower-bar in site.css. *@
                @foreach (var bloon in Model.Bloons)
                {
                    <div class="tower-item" data-search-item data-name="@bloon.Name.ToLowerInvariant()" style="--cat-color: @bloon.Color">
                        <div class="tower-bar"></div>
                        <div class="tower-card">
                            <div class="tower-hexagon">
                                <img src="~/images/bloons/@bloon.Image" alt="@bloon.Name">
                            </div>
                            <p>@bloon.Name</p>
                        </div>
                    </div>
                }
            </div>

            <p class="no-results" data-no-results style="display:@(Model.Bloons.Count == 0 ? "block" : "none")">No bloons found.</p>
        </div>
    </main>
</div>

@section Scripts {
    <script src="~/js/list-search.js" asp-append-version="true"></script>
}
