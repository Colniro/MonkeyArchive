@{
    ViewData["Title"] = "El Primo";
}

<div class="towers-page">
    <partial name="_Navigation" />

    <section class="tower-hero" style="--hero-light: #2F80ED; --hero-dark: #0C1F4A;">
        <div class="container tower-hero-inner">
            <img src="~/images/assets/primo.png" alt="El Primo" class="tower-hero-image">
            <div>
                <h1 class="tower-hero-title">El Primo</h1>
                <p class="tower-hero-desc">A luchador who wandered in from a completely different game. His whole kit is four punches and a flying elbow drop, he has never seen a Bloon, and nobody on the team remembers adding him to the database.</p>
            </div>
        </div>
    </section>

    <main class="towers-main">
        <div class="container">
            <div class="stat-panel">
                <div class="stat-item">
                    <span class="stat-label">Cost</span>
                    <span class="stat-value">Free</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Damage</span>
                    <span class="stat-value">&iexcl;&Oacute;rale!</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Pierce</span>
                    <span class="stat-value">Fourth wall</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Range</span>
                    <span class="stat-value">One (1) hug</span>
                </div>
            </div>
            <p class="stat-caption">Stats on Medium difficulty - unverified, unbalanced, and not our fault</p>

            <div class="upgrade-grid">
                <div class="upgrade-card" style="--path-color: #1B4332;">
                    <span class="upgrade-path">Star Power</span>
                    <h3 class="upgrade-name">El Fuego</h3>
                    <p class="upgrade-desc">His fists stay lit between rounds. Everything he touches keeps burning afterwards, which is not a thing this game does.</p>
                    <span class="upgrade-price">???</span>
                </div>
                <div class="upgrade-card" style="--path-color: #A8241F;">
                    <span class="upgrade-path">Star Power</span>
                    <h3 class="upgrade-name">Meteor Rush</h3>
                    <p class="upgrade-desc">Gets faster every time he lands his Super. Nobody has told him yet that the track is a loop.</p>
                    <span class="upgrade-price">???</span>
                </div>
                <div class="upgrade-card" style="--path-color: #7A4E10;">
                    <span class="upgrade-path">Gadget</span>
                    <h3 class="upgrade-name">Suplex Supplement</h3>
                    <p class="upgrade-desc">Grabs the nearest MOAB and suplexes it into the ground. The MOAB is a blimp. He does it anyway.</p>
                    <span class="upgrade-price">???</span>
                </div>
            </div>

            <p class="stat-caption">You found the secret. Tell no one. <a asp-controller="Home" asp-action="Index">Back to safety</a></p>
        </div>
    </main>
</div>
