@{
    var loggedInUsername = Context.Session.GetString("Username");
    var isLoggedIn = !string.IsNullOrEmpty(loggedInUsername);

    // Der Admin Link steht nur fuer den Admin im Menue. Die Pruefung selbst
    // liegt im AdminController, hier wird dieselbe Methode benutzt, damit es
    // nur eine Stelle mit der Regel gibt.
    var isAdmin = MonkeyArchive.Controllers.AdminController.IsAdmin(Context);
}

<header>
    <div class="logo-group">
        <a asp-controller="Home" asp-action="Index">
            <span class="logo-badge">
                <img src="~/images/monkeys/village.png" alt="Monkey Archive Logo">
            </span>
        </a>
        <a asp-controller="Home" asp-action="Index">Monkey Archive</a>
    </div>

    @* Handy Version: Die Checkbox ist der ganze Schalter fuer das Menue.
       Sie ist unsichtbar, das Label mit den drei Balken gehoert dazu und
       schaltet sie um. Das CSS blendet damit das <nav> als Vollbild Menue ein.
       So braucht es kein JavaScript. Auf dem Desktop ist beides ausgeblendet. *@
    <input class="nav-toggle" type="checkbox" id="nav-toggle" aria-label="Menue">
    <label class="nav-burger" for="nav-toggle">
        <span></span>
        <span></span>
        <span></span>
    </label>

    <nav>
        <div class="nav-links">
            <a class="nav-link" asp-controller="Towers" asp-action="Index">Towers</a>
            <a class="nav-link" asp-controller="Bloons" asp-action="Index">Bloons</a>
            @if (isLoggedIn)
            {
                <a class="nav-link" asp-controller="Account" asp-action="Favorites">Favorites</a>
            }
            @if (isAdmin)
            {
                <a class="nav-link nav-link-admin" asp-controller="Admin" asp-action="Index">Admin</a>
            }
        </div>

        <span class="nav-divider" aria-hidden="true"></span>

        @if (isLoggedIn)
        {
            <div class="account-group">
                <span class="account-badge">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="2" />
                        <path d="M4 20c0-4.418 3.582-8 8-8s8 3.582 8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    @loggedInUsername
                </span>
                <form method="post" asp-controller="Account" asp-action="Logout" class="logout-form">
                    <button type="submit" class="logout-btn">Log Out</button>
                </form>
            </div>
        }
        else
        {
            <a class="login-btn" asp-controller="Account" asp-action="Login">Log In</a>
        }
    </nav>
</header>
