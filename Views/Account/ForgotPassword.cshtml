@{
    ViewData["Title"] = "Forgot Password";
    var error = ViewData["Error"] as string;
}

<div class="auth-page">
    <div class="auth-card">
        <a asp-controller="Home" asp-action="Index" class="auth-close" aria-label="Continue without an account" title="Continue without an account">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                <line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
        </a>

        <h1 class="auth-title">Monkey Archive</h1>
        <p class="auth-subtitle">Find your account</p>

        @if (!string.IsNullOrEmpty(error))
        {
            <p class="auth-error">@error</p>
        }

        <form method="post" asp-controller="Account" asp-action="ForgotPassword">
            <div class="auth-field">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" required autocomplete="username">
            </div>

            <button type="submit" class="auth-submit">Continue</button>
        </form>

        <p class="auth-footer">Remembered it? <a asp-controller="Account" asp-action="Login">Log in</a></p>
    </div>
</div>
